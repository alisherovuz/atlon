# ─────────────────────────────────────────────────────────────
#  ATLON GROUP BOT — environment variables
#  Copy this file to `.env` for local development.
#  On Railway, add these same keys under Variables (no .env needed).
# ─────────────────────────────────────────────────────────────

# REQUIRED — token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token-here

# REQUIRED for subscription gate.
# The public channel users must join. Use the @username.
# The bot MUST be an ADMIN of this channel, otherwise it cannot
# check who is subscribed.
CHANNEL_USERNAME=@atlongroup
# Optional: the clickable invite link shown on the button.
# Defaults to https://t.me/<username without @>
CHANNEL_URL=https://t.me/atlongroup

# REQUIRED — comma-separated Telegram user IDs allowed to use /admin.
# Find your ID by messaging @userinfobot.
ADMIN_IDS=111111111,222222222

# Card shown to applicants at the payment step of event registration.
# Write it exactly as it should appear, spaces included.
# Set the real number in Railway Variables — this file is committed to git.
PAYMENT_CARD=0000 0000 0000 0000

# Password for the browser admin panel (Railway public domain).
# Without it the panel refuses every login.
ADMIN_PASSWORD=choose-a-strong-password

# Optional — signs the panel's login cookie. Defaults to a value derived
# from BOT_TOKEN, which is fine; set it to rotate all sessions at once.
SESSION_SECRET=

# Group chat IDs that receive volunteer applications, per region.
# Add the bot to each group, then the ID looks like -1001234567890.
# Leave any of these blank — that region simply won't forward to a group.
GROUP_ANDIJAN=
GROUP_BUKHARA=
GROUP_FERGANA=
GROUP_JIZZAKH=
GROUP_NAMANGAN=
GROUP_NAVOI=
GROUP_KASHKADARYA=
GROUP_KARAKALPAKSTAN=
GROUP_SAMARKAND=
GROUP_SYRDARYA=
GROUP_SURKHANDARYA=
GROUP_TASHKENT=
GROUP_TASHKENT_REGION=
GROUP_KHOREZM=

# Optional — Postgres connection string.
# On Railway, add a Postgres plugin and it provides DATABASE_URL
# automatically. If unset, the bot falls back to a local SQLite file
# (data is lost on redeploy, so use Postgres in production).
DATABASE_URL=
